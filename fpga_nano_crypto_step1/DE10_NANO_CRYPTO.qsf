set_global_assignment -name VERILOG_FILE terasic/autofocus/VCM_CTRL_P.v
set_global_assignment -name VERILOG_FILE terasic/autofocus/VCM_I2C.v
set_global_assignment -name VERILOG_FILE terasic/common/CLOCKMEM.v
set_global_assignment -name VERILOG_FILE terasic/common/CLOCK_DELAY.v
set_global_assignment -name VERILOG_FILE terasic/common/FpsMonitor.v
set_global_assignment -name VERILOG_FILE terasic/common/I2C_READ_DATA.v
