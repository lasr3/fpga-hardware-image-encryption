# DE10-Nano: D8M camera -> AES-128 video encryption -> HDMI
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY DE10_NANO_CRYPTO
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"
set_global_assignment -name SEARCH_PATH rtl/aes
set_global_assignment -name SEARCH_PATH terasic/vga
set_global_assignment -name SEARCH_PATH terasic/d8m
set_global_assignment -name SDC_FILE DE10_NANO_CRYPTO.sdc

set_global_assignment -name VERILOG_FILE rtl/DE10_NANO_CRYPTO.v
set_global_assignment -name VERILOG_FILE rtl/sys_pll.v
set_global_assignment -name VERILOG_FILE rtl/cam_frame_buffer.v
set_global_assignment -name VERILOG_FILE rtl/video_crypt.v
set_global_assignment -name VERILOG_FILE rtl/aes/aes_round.v
set_global_assignment -name VERILOG_FILE rtl/aes/aes_key_expand.v
set_global_assignment -name VERILOG_FILE rtl/aes/aes128_enc_pipe.v
set_global_assignment -name VERILOG_FILE terasic/autofocus/AUTO_FOCUS_ON.v
set_global_assignment -name VERILOG_FILE terasic/autofocus/AUTO_SYNC_MODIFY.v
set_global_assignment -name VERILOG_FILE terasic/autofocus/FOCUS_ADJ.v
set_global_assignment -name VERILOG_FILE terasic/autofocus/F_VCM.v
set_global_assignment -name VERILOG_FILE terasic/autofocus/I2C_DELAY.v
